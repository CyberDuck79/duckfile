# Example environment configuration for Duckfile
# Copy this file to .env and customize for your environment

# Project settings
PROJECT_NAME=myapp
VERSION=1.0.0
ENVIRONMENT=development

# Registry settings
DOCKER_REGISTRY=ghcr.io/myorg
DOCKER_TAG=${VERSION}-${ENVIRONMENT}

# Database configuration
DB_HOST=localhost
DB_NAME=${PROJECT_NAME}_${ENVIRONMENT}
DB_USER=admin
# DB_PASSWORD=secret  # Uncomment and set in your local .env

# Go build settings
GO_VERSION=1.21
GOARCH=amd64
GOOS=linux

# Debug settings
DEBUG=true
VERBOSE=false

# API Keys (set these in your local .env file)
# API_KEY=your-api-key-here
# GITHUB_TOKEN=your-github-token
